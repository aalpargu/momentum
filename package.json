{
  "name": "momentum",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0 && npm run typecheck",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "check:assets": "node scripts/check-static-assets.mjs",
    "check": "npm run test && npm run lint && npm run check:assets && npm run build",
    "supabase:db:push": "supabase db push",
    "supabase:functions:deploy": "supabase functions deploy analyze-screen-time && supabase functions deploy delete-account"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.115.0",
    "@vercel/analytics": "2.0.1",
    "@vitejs/plugin-react": "6.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.10",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "supabase": "2.116.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0"
  }
}
